datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ================================
// ENUMS
// ================================

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum RequestStatus {
  SOLICITADO
  CANCELADO
  AGENDADO
  RECIBIDO
  EN_PROCESO
  ESPERANDO_PIEZA
  LISTO_PARA_ENTREGA
  ENTREGADO
  EN_GARANTIA
  RESUELTO
  CERRADO
}

enum TradeInStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ================================
// USERS
// ================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  technicianProfile TechnicianProfile?
  serviceRequests   ServiceRequest[] @relation("ClientRequests")
  chatbotLogs       ChatbotLog[]
  tradeInEstimates  TradeInEstimate[]
  assignedServices  ServiceRequest[] @relation("TechnicianServices")

  statusHistoryEntries ServiceRequestStatusHistory[] @relation("StatusHistoryActor")

  @@map("users")
}

// ================================
// TECHNICIANS
// ================================

model TechnicianProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  bio         String?  @db.Text
  address     String?
  isAvailable Boolean  @default(true) @map("is_available")
  rating      Float    @default(0.0)
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("technician_profiles")
}

// ================================
// CHATBOT
// ================================

model ChatbotLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  inputText      String   @db.Text @map("input_text")
  predictedIssue String   @map("predicted_issue")
  confidence     Float
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chatbot_logs")
}

// ================================
// SERVICE REQUESTS
// ================================

model ServiceRequest {
  id           String  @id @default(uuid())
  clientId     String  @map("client_id")
  technicianId String? @map("technician_id")

  title         String        @db.VarChar(120)
  description   String        @db.Text
  deviceType    String        @map("device_type") @db.VarChar(50)
  latitude      Float
  longitude     Float

  status        RequestStatus @default(SOLICITADO)
  estimatedCost Float?        @map("estimated_cost")
  finalCost     Float?        @map("final_cost")
  scheduledAt   DateTime?     @map("scheduled_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  client     User  @relation("ClientRequests", fields: [clientId], references: [id])
  technician User? @relation("TechnicianServices", fields: [technicianId], references: [id], onDelete: Restrict)

  review        Review?
  statusHistory ServiceRequestStatusHistory[]

  @@index([clientId, createdAt])
  @@index([technicianId, status])
  @@index([status, createdAt])
  @@map("service_requests")
}

// ================================
// SERVICE REQUEST STATUS HISTORY
// ================================

model ServiceRequestStatusHistory {
  id               String        @id @default(uuid())
  serviceRequestId String        @map("service_request_id")
  previousStatus   RequestStatus? @map("previous_status")
  newStatus        RequestStatus  @map("new_status")
  actorId          String        @map("actor_id")
  actorRole        Role          @map("actor_role")
  createdAt        DateTime      @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  actor          User           @relation("StatusHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@index([actorId, createdAt])
  @@map("service_request_status_history")
}

// ================================
// TRADE-IN
// ================================

model TradeInEstimate {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  deviceType     String        @map("device_type")
  hardwareSpecs  Json          @map("hardware_specs")
  estimatedValue Float         @map("estimated_value")
  status         TradeInStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("trade_in_estimates")
}

// ================================
// REVIEWS
// ================================

model Review {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique @map("service_request_id")
  rating           Int
  comment          String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("reviews")
}